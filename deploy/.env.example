# Sunucunun alan adı (DNS A kaydı VPS IP'sine yönlenmeli)
HIBRO_DOMAIN=api.ornek.com
HIBRO_CITIES=izmir,konya,gaziantep
HIBRO_REFRESH=24h
# Rota planlayıcı kuruluysa:
# HIBRO_MOTIS_URL=http://motis:8080

# Veri toplama (izinli, anonim). Kapatmak için: HIBRO_COLLECT=off
HIBRO_COLLECT=on
HIBRO_TRIP_RETENTION_DAYS=30
HIBRO_REPORT_RETENTION_DAYS=365
# /admin/stats için uzun rastgele bir değer: openssl rand -hex 32
HIBRO_ADMIN_TOKEN=
